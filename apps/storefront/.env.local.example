# ============================================
# Backend Medusa (Store API)
# ============================================
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# ============================================
# Publishable API Key (Storefront)
# IMPORTANT :
# - doit être une variable SERVEUR (pas NEXT_PUBLIC_)
# - utilisée dans les headers SSR
# ============================================
MEDUSA_PUBLISHABLE_API_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx

# ============================================
# Admin API Key (optionnel)
# Pour les appels admin côté backend uniquement
# ============================================
MEDUSA_ADMIN_API_KEY=

# ============================================
# Next.js
# ============================================
NODE_ENV=development
